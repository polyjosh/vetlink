{
  "name": "mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "jest --maxWorkers=50%",
    "bundle:android": "expo export --platform android --output-dir dist-export"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "@vetlink/api-client": "workspace:*",
    "@vetlink/i18n": "workspace:*",
    "@vetlink/shared": "workspace:*",
    "@vetlink/ui-tokens": "workspace:*",
    "expo": "58.0.11",
    "expo-constants": "58.0.12",
    "expo-crypto": "58.0.6",
    "expo-device": "58.0.5",
    "expo-image-manipulator": "58.0.14",
    "expo-image-picker": "58.0.10",
    "expo-linking": "58.0.13",
    "expo-location": "58.0.16",
    "expo-network": "58.0.3",
    "expo-notifications": "58.1.4",
    "expo-router": "58.0.20",
    "expo-secure-store": "58.0.2",
    "expo-sqlite": "58.0.13",
    "expo-status-bar": "58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "5.10.1",
    "react-native-screens": "4.30.0",
    "react-native-svg": "15.16.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.3.0",
    "jest": "30.5.2",
    "jest-expo": "58.0.11",
    "test-renderer": "1.3.1",
    "typescript": "6.0.3"
  },
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/test/**/*.test.ts?(x)"
    ],
    "moduleNameMapper": {
      "^@vetlink/(shared|i18n|api-client|ui-tokens)$": "<rootDir>/../../packages/$1/src/index.ts",
      "^(\\.{1,2}/.*)\\.js$": "$1",
      "^@/(.*)$": "<rootDir>/src/$1"
    },
    "testTimeout": 30000
  }
}
