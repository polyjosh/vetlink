{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --conditions=@vetlink/source src/server.ts",
    "worker": "tsx watch --conditions=@vetlink/source src/worker.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/db/migrations', 'dist/db/migrations', { recursive: true })\"",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "start:migrate": "node dist/db/run-migrations.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "node --conditions=@vetlink/source node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx --conditions=@vetlink/source --env-file-if-exists=../../.env src/db/run-migrations.ts",
    "db:seed": "tsx --conditions=@vetlink/source --env-file-if-exists=../../.env src/db/seed/run.ts",
    "db:studio": "node --conditions=@vetlink/source --env-file-if-exists=../../.env node_modules/drizzle-kit/bin.cjs studio",
    "api:generate": "tsx --conditions=@vetlink/source src/openapi/export.ts ../../packages/api-client/openapi.json && pnpm --filter @vetlink/api-client generate",
    "ussd:sim": "tsx --env-file-if-exists=../../.env scripts/ussd-sim.ts"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.1",
    "@fastify/swagger-ui": "6.1.1",
    "@vetlink/i18n": "workspace:*",
    "@vetlink/shared": "workspace:*",
    "bullmq": "6.3.10",
    "close-with-grace": "2.5.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "fastify-type-provider-zod": "7.0.0",
    "ioredis": "6.0.0",
    "jose": "6.2.12",
    "openapi-types": "12.1.3",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@vetlink/api-client": "workspace:*",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
