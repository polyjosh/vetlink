{
  "name": "api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --conditions=@vetlink/source src/server.ts",
    "worker": "tsx watch --conditions=@vetlink/source src/worker.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/db/migrations', 'dist/db/migrations', { recursive: true })\"",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "start:migrate": "node dist/db/migrate.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "node --conditions=@vetlink/source node_modules/drizzle-kit/bin.cjs generate",
    "db:migrate": "tsx --conditions=@vetlink/source --env-file-if-exists=../../.env src/db/migrate.ts",
    "db:seed": "tsx --conditions=@vetlink/source --env-file-if-exists=../../.env src/db/seed/run.ts",
    "db:studio": "node --conditions=@vetlink/source --env-file-if-exists=../../.env node_modules/drizzle-kit/bin.cjs studio",
    "api:generate": "node -e \"console.error('api:generate is added in Milestone 5'); process.exit(1)\"",
    "ussd:sim": "node -e \"console.error('ussd:sim is added in Milestone 6'); process.exit(1)\""
  },
  "dependencies": {
    "@vetlink/i18n": "workspace:*",
    "@vetlink/shared": "workspace:*",
    "close-with-grace": "2.5.0",
    "drizzle-orm": "0.45.4",
    "fastify": "5.12.5",
    "ioredis": "6.0.0",
    "pino": "10.3.1",
    "postgres": "3.4.9",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "drizzle-kit": "0.31.11",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
