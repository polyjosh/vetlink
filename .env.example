# Copy to .env for local development: cp .env.example .env
# Placeholders only. Never commit real credentials.

APP_ENV=development
LOG_LEVEL=info
# Oldest supported app version (GET /v1/meta/min-app-version)
MIN_APP_VERSION=1.0.0
# Reverse-proxy IPs/CIDRs (or loopback/linklocal/uniquelocal) whose X-Forwarded-For is trusted.
# Empty locally. Set in production behind the proxy, or per-IP limits see one address for all.
TRUST_PROXY=

# Postgres (docker compose builds the in-container DATABASE_URL from these)
DB_USER=vetlink
DB_PASSWORD=change-me-local
DB_NAME=vetlink
# From the host (Drizzle Studio, DBeaver). Inside Docker the host is `db`.
DATABASE_URL=postgres://vetlink:change-me-local@localhost:5432/vetlink
# DB integration tests (pnpm test) create and drop throwaway databases on this server.
TEST_DATABASE_URL=postgres://vetlink:change-me-local@localhost:5432/vetlink
# Redis-backed tests use this logical DB and clear only their own keys.
TEST_REDIS_URL=redis://localhost:6379/15
REDIS_URL=redis://localhost:6379

# Access-token signing key, at least 32 characters. Generate: openssl rand -base64 32
JWT_SECRET=

# Field encryption master key (national IDs, TOTP secrets). Generate: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# Object storage (SeaweedFS locally, S3-compatible bucket in production)
S3_ENDPOINT=http://localhost:8333
# What phones/browsers use for presigned upload/view URLs (e.g. http://192.168.1.20:8333 for a
# phone on the LAN). Empty = S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=http://localhost:8333
S3_BUCKET=vetlink-local
S3_ACCESS_KEY=vetlink-local
S3_SECRET_KEY=change-me-local

# Africa's Talking (USSD + SMS)
AT_API_KEY=
AT_USERNAME=sandbox
AT_SENDER_ID=

# Safaricom Daraja (M-Pesa STK push)
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=
DARAJA_PASSKEY=

# Public HTTPS URL (tunnel) that webhooks call back to
PUBLIC_BASE_URL=
# Webhook URLs carry this as ?token= (e.g. ${PUBLIC_BASE_URL}/webhooks/ussd?token=...).
# Optional locally, required in production. Generate: openssl rand -hex 24
WEBHOOK_SECRET=

# Dev shortcuts. Startup FAILS if these are log/mock with APP_ENV=production.
SMS_MODE=log
PAYMENTS_MODE=mock
# Optional fixed 6-digit OTP for every login (dev only). Empty = random codes.
OTP_FIXED_CODE=
# App push: log (prints; dev only, refused in production) or expo. Token only if enhanced push
# security is on in EAS.
PUSH_MODE=log
EXPO_ACCESS_TOKEN=

MAPS_API_KEY=
SENTRY_DSN=

# USSD service code shown on the login screens ("Dial *XXX# from any phone"). Inlined into the
# web and app builds; leave empty to hide the card. Next.js reads apps/web/.env, Expo apps/mobile/.env.
NEXT_PUBLIC_USSD_CODE=
EXPO_PUBLIC_USSD_CODE=
